{
  "name": "solana-tx",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/*.test.ts",
    "_hack": "pnpm _hack1 && pnpm _hack2 && pnpm _hack3 && pnpm _hack4",
    "_hack1": "cp './node_modules/.pnpm/@solanafm+utils@1.1.0/node_modules/dayjs/plugin/relativeTime.js' './node_modules/.pnpm/@solanafm+utils@1.1.0/node_modules/dayjs/esm/plugin/relativeTime'",
    "_hack2": "cp './node_modules/.pnpm/@solanafm+utils@1.1.0/node_modules/dayjs/plugin/relativeTime.js' './node_modules/dayjs/plugin/relativeTime'",
    "_hack3": "cp './node_modules/.pnpm/@solanafm+utils@1.1.0/node_modules/dayjs/plugin/utc.js' './node_modules/.pnpm/@solanafm+utils@1.1.0/node_modules/dayjs/esm/plugin/utc'",
    "_hack4": "cp './node_modules/.pnpm/@solanafm+utils@1.1.0/node_modules/dayjs/plugin/utc.js' './node_modules/dayjs/plugin/utc'",
    "build": "pnpm _hack && webpack --mode production",
    "develop": "pnpm build && webpack-dev-server --mode development",
    "start:dev": "pnpm develop",
    "lint:ts": "eslint .",
    "lint:ts-fix": "eslint . --fix",
    "lint": "pnpm run lint:ts",
    "lint:fix": "pnpm run lint:ts-fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check",
    "fix": "pnpm lint:fix && pnpm format",
    "prepare": "husky"
  },
  "keywords": [
    "solana",
    "transaction",
    "parser"
  ],
  "author": "chalda",
  "license": "ISC",
  "files": [
    "src"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@debridge-finance/solana-transaction-parser": "^3.5.0",
    "@solana/spl-governance": "^0.3.28",
    "@solana/web3.js": "^1.99.0",
    "@solanafm/explorer-kit": "^1.2.0",
    "@solanafm/explorer-kit-idls": "^1.1.4",
    "@solanafm/utils": "^1.1.0",
    "assert": "^2.1.0",
    "base64-js": "^1.5.1",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.23",
    "pako": "^3.0.3",
    "process": "^0.11.10",
    "stream": "^0.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marinade.finance/eslint-config": "2.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "expose-loader": "^5.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  }
}
