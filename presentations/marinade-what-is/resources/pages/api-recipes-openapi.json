{"openapi":"3.1.0","info":{"title":"Marinade Recipes — Redirects API","description":"Reward redirects served from the marinade-config on-chain registry, behind a self-evicting cache.","license":{"name":"MIT","identifier":"MIT"},"version":"0.1.0"},"paths":{"/recipes/runs":{"get":{"tags":[],"summary":"Recipe runs cached from BigQuery, with optional filters","operationId":"recipe_runs_list_handler","parameters":[{"name":"uuid","in":"query","required":false,"schema":{"type":["string","null"]}},{"name":"recipe","in":"query","required":false,"schema":{"type":["string","null"]}},{"name":"epoch_from","in":"query","required":false,"schema":{"type":["integer","null"],"format":"int64","minimum":0}},{"name":"epoch_to","in":"query","required":false,"schema":{"type":["integer","null"],"format":"int64","minimum":0}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecipeRunsListResponse"}}}},"503":{"description":"BigQuery cache not yet populated"}}}},"/redirects/{withdraw_authority}/all":{"get":{"tags":[],"summary":"Every on-chain redirect for a single withdraw authority, in one call","operationId":"all_handler","parameters":[{"name":"withdraw_authority","in":"path","description":"Solana withdraw authority pubkey","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"All scopes for this authority (possibly empty). A per-recipe entry overrides the `recipe=null` (all-recipes) entry.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AllRedirectsResponse"}}}},"400":{"description":"Malformed withdraw authority"},"503":{"description":"RPC unavailable"}}}}},"components":{"schemas":{"AllRedirectsResponse":{"type":"object","description":"Every on-chain redirect a wallet has, in a single call.","required":["withdraw_authority","redirects"],"properties":{"redirects":{"type":"array","items":{"$ref":"#/components/schemas/ScopedRedirect"},"description":"One item per scope; a per-recipe item overrides the `recipe: null` one."},"withdraw_authority":{"type":"string"}}},"RecipeRunResponse":{"type":"object","required":["uuid","recipe","epoch","kind","run_time","epoch_duration_seconds","sol_staked","sol_rewards","ssi_sol","ssi_delta_bps","sol_distributed"],"properties":{"epoch":{"type":"integer","format":"int64","minimum":0},"epoch_duration_seconds":{"type":"integer","format":"int64"},"kind":{"type":"string"},"output_mint":{"type":["string","null"]},"output_mint_decimals":{"type":["integer","null"],"format":"int32","minimum":0},"recipe":{"type":"string"},"run_time":{"type":"string"},"sol_distributed":{"type":"string"},"sol_rewards":{"type":"string"},"sol_staked":{"type":"string"},"ssi_delta_bps":{"type":"integer","format":"int32"},"ssi_sol":{"type":"string"},"tokens_distributed":{"type":["string","null"]},"tokens_distributed_usd_value":{"type":["string","null"]},"uuid":{"type":"string"}}},"RecipeRunsListResponse":{"type":"object","required":["runs","loaded_at"],"properties":{"loaded_at":{"type":"string"},"runs":{"type":"array","items":{"$ref":"#/components/schemas/RecipeRunResponse"}}}},"ScopedRedirect":{"type":"object","description":"One scope's entry within an [`AllRedirectsResponse`].","required":["block_timestamp"],"properties":{"block_timestamp":{"type":"string","description":"On-chain write time (`Clock::unix_timestamp`) as RFC 3339."},"recipe":{"type":["string","null"],"description":"`null` = the all-recipes (`ALL`) entry."},"redirect_rewards":{"type":["string","null"],"description":"`null` = explicit clear (pay the withdraw authority)."}}}}}}